{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resalewebsite",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true
  }
}
