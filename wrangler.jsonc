{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resalewebsite",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "RML_MARKETPLACE_TRANSPORT": "frontend-api-depop-parallel-recovery",
    "RML_GRAILED_SEARCH": "public-index",
    "NEXT_PUBLIC_SITE_URL": "https://resalemasterlab.cloud-cord.com",
    "RML_FEATURES": "thrift-check,listing-template,parallel-depop-recovery"
  },
  "routes": [
    {
      "pattern": "resalemasterlab.cloud-cord.com",
      "custom_domain": true
    }
  ]
}
