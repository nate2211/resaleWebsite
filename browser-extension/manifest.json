{
  "manifest_version": 3,
  "name": "ResaleMasterLab Browser Bridge",
  "version": "3.0.0",
  "description": "Captures Depop and other marketplace results from normal rendered Chrome or Edge tabs without routing Depop through cloud fetches.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.depop.com/*",
    "https://www.grailed.com/*",
    "https://poshmark.com/*",
    "https://jp.mercari.com/*",
    "https://zenmarket.jp/*",
    "https://search.rakuten.co.jp/*",
    "https://item.rakuten.co.jp/*",
    "https://auctions.yahoo.co.jp/*",
    "https://fril.jp/*",
    "https://globalbunjang.com/*",
    "https://www.ebay.com/*",
    "https://www.mercari.com/*",
    "https://www.facebook.com/marketplace/*",
    "https://www.superbuy.com/*",
    "https://www.goofish.com/*",
    "https://2.taobao.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://resalemasterlab.cloud-cord.com/*",
        "https://resalemasterlab.com/*",
        "https://www.resalemasterlab.com/*",
        "https://resalewebsite.unusualsuspectsclothing.workers.dev/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.depop.com/*",
        "https://www.grailed.com/*",
        "https://poshmark.com/*",
        "https://jp.mercari.com/*",
        "https://zenmarket.jp/*",
        "https://search.rakuten.co.jp/*",
        "https://item.rakuten.co.jp/*",
        "https://auctions.yahoo.co.jp/*",
        "https://fril.jp/*",
        "https://globalbunjang.com/*",
        "https://www.ebay.com/*",
        "https://www.mercari.com/*",
        "https://www.facebook.com/marketplace/*",
        "https://www.superbuy.com/*",
        "https://www.goofish.com/*",
        "https://2.taobao.com/*"
      ],
      "js": [
        "marketplace-content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ResaleMasterLab Browser Bridge"
  }
}
